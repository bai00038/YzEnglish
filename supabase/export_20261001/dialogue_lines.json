  "scene_id": 31,
  "line_order": 5,
  "step": null,
  "speaker": "Clerk",
  "speaker_zh": "工作人员",
  "dialogue_en": "I'm all set. The refund has been processed.",
  "dialogue_zh": "已经办好了。退款已经处理完成。",
  "start_time": 19.1,
