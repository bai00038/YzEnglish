  "scene_id": 42,
  "line_order": 27,
  "step": null,
  "speaker": "Parent",
  "speaker_zh": "家长",
  "dialogue_en": "That sounds good.",
  "dialogue_zh": "听起来不错。",
  "start_time": 53.5,
  "end_time": 53.8,
  "created_at": "2026-08-12T22:17:56.886809+00:00",
  "updated_at": "2026-08-12T22:48:18.509006+00:00",
  "external_line_id": "scene_027_line_027"
 },
 {
