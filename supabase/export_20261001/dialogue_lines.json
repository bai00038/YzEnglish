  "line_order": 1,
  "step": null,
  "speaker": "Pharmacist",
  "speaker_zh": "药剂师",
  "dialogue_en": "Hi there! How can I help you today?",
  "dialogue_zh": "你好！今天有什么可以帮你的吗？",
  "start_time": 0.12,
  "end_time": 1.56,
  "created_at": "2026-08-13T04:20:20.799726+00:00",
  "updated_at": "2026-08-13T13:40:57.884875+00:00",
  "external_line_id": "scene_018_line_001"
 },
 {
  "id": 1858,
  "scene_id": 43,
  "line_order": 2,
  "step": null,
  "speaker": "Customer",
  "speaker_zh": "顾客",
  "dialogue_en": "Hi, I’m here to pick up a prescription for Aria.",
  "dialogue_zh": "你好，我来取 Aria 的处方药。",
  "start_time": 1.66,
  "end_time": 3.56,
  "created_at": "2026-08-13T04:20:20.799726+00:00",
  "updated_at": "2026-08-13T13:40:57.884875+00:00",
  "external_line_id": "scene_018_line_002"
 },
 {
  "id": 1859,
  "scene_id": 43,
  "line_order": 3,
  "step": null,
  "speaker": "Pharmacist",
  "speaker_zh": "药剂师",
  "dialogue_en": "Sure. Could you please confirm your date of birth and address?",
  "dialogue_zh": "好的。请确认一下你的出生日期和地址。",
  "start_time": 3.58,
  "end_time": 5.8,
  "created_at": "2026-08-13T04:20:20.799726+00:00",
  "updated_at": "2026-08-13T13:40:57.884875+00:00",
  "external_line_id": "scene_018_line_003"
 },
 {
  "id": 1860,
  "scene_id": 43,
  "line_order": 4,
  "step": null,
  "speaker": "Customer",
  "speaker_zh": "顾客",
  "dialogue_en": "Yes, it’s October 12th, 1995, and I live at 23 Maple Street.",
  "dialogue_zh": "好的，我的出生日期是 1995 年 10 月 12 日，住址是枫树街 23 号。",
  "start_time": 6.1,
  "end_time": 10.94,
  "created_at": "2026-08-13T04:20:20.799726+00:00",
  "updated_at": "2026-08-13T13:40:57.884875+00:00",
  "external_line_id": "scene_018_line_004"
 },
 {
  "id": 1861,
  "scene_id": 43,
  "line_order": 5,
  "step": null,
  "speaker": "Pharmacist",
  "speaker_zh": "药剂师",
  "dialogue_en": "Great. The doctor prescribed amoxicillin.",
  "dialogue_zh": "好的，医生给你开了阿莫西林。",
  "start_time": 10.96,
  "end_time": 12.94,
  "created_at": "2026-08-13T04:20:20.799726+00:00",
  "updated_at": "2026-08-13T13:40:57.884875+00:00",
  "external_line_id": "scene_018_line_005"
 },
 {
  "id": 1862,
  "scene_id": 43,
  "line_order": 6,
  "step": null,
  "speaker": "Customer",
  "speaker_zh": "顾客",
  "dialogue_en": "How should I take it?",
  "dialogue_zh": "这个药应该怎么吃？",
  "start_time": 13.16,
  "end_time": 13.8,
  "created_at": "2026-08-13T04:20:20.799726+00:00",
  "updated_at": "2026-08-13T13:40:57.884875+00:00",
  "external_line_id": "scene_018_line_006"
 },
 {
  "id": 1863,
  "scene_id": 43,
  "line_order": 7,
  "step": null,
  "speaker": "Pharmacist",
  "speaker_zh": "药剂师",
  "dialogue_en": "Twice a day with food. Make sure to finish it.",
  "dialogue_zh": "每天两次，随餐服用。一定要按疗程吃完。",
  "start_time": 14.04,
  "end_time": 15.94,
  "created_at": "2026-08-13T04:20:20.799726+00:00",
  "updated_at": "2026-08-13T13:40:57.884875+00:00",
  "external_line_id": "scene_018_line_007"
 },
 {
  "id": 1864,
  "scene_id": 43,
  "line_order": 8,
  "step": null,
  "speaker": "Customer",
  "speaker_zh": "顾客",
  "dialogue_en": "Are there any side effects?",
  "dialogue_zh": "有什么副作用吗？",
  "start_time": 16.74,
  "end_time": 17.71,
  "created_at": "2026-08-13T04:20:20.799726+00:00",
  "updated_at": "2026-08-13T13:40:57.884875+00:00",
  "external_line_id": "scene_018_line_008"
 },
