  "scene_id": 42,
  "line_order": 29,
  "step": null,
  "speaker": "Parent",
  "speaker_zh": "家长",
  "dialogue_en": "Thank you.",
  "dialogue_zh": "谢谢。",
  "start_time": 55.9,
  "end_time": 56.14,
  "created_at": "2026-08-12T22:42:10.269352+00:00",
