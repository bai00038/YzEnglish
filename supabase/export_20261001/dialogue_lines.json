  "line_order": 1,
  "step": null,
  "speaker": "Customer",
  "speaker_zh": "顾客",
  "dialogue_en": "Hi, I bought a lunch bag here last week, and I noticed it's on sale now. I was wondering if I could get a price adjustment?",
  "dialogue_zh": "你好，我上周在这里买了一个午餐包，后来发现它现在打折了。我想问一下，可以给我退差价吗？",
  "start_time": 0.4,
  "end_time": 6.73,
  "created_at": "2026-08-13T02:49:23.163762+00:00",
  "updated_at": "2026-08-13T12:51:12.424385+00:00",
  "external_line_id": "scene_004_line_001"
 },
