  "line_order": 3,
  "step": null,
  "speaker": "Customer",
  "speaker_zh": "顾客",
  "dialogue_en": "Not with me, but I think I can find it in the Costco app.",
  "dialogue_zh": "没带，不过我想我可以在 Costco App 里找到。",
  "start_time": 8.88,
  "end_time": 12.16,
  "created_at": "2026-08-13T02:49:23.163762+00:00",
  "updated_at": "2026-08-13T12:51:12.424385+00:00",
  "external_line_id": "scene_004_line_003"
