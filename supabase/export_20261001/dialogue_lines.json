  "scene_id": 42,
  "line_order": 28,
  "step": null,
  "speaker": "Teacher",
  "speaker_zh": "老师",
  "dialogue_en": "He has a lot of potential.",
  "dialogue_zh": "他很有潜力。",
  "start_time": 54.5,
  "end_time": 55.1,
  "created_at": "2026-08-12T22:17:56.886809+00:00",
  "updated_at": "2026-08-12T22:48:18.509006+00:00",
  "external_line_id": "scene_027_line_028"
 },
 {
