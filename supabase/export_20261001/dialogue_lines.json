  "line_order": 4,
  "step": null,
  "speaker": "Clerk",
  "speaker_zh": "工作人员",
  "dialogue_en": "No worries. I can also look it up using your membership card.",
  "dialogue_zh": "没关系。我也可以用您的会员卡帮您查询。",
  "start_time": 13.32,
  "end_time": 16.48,
  "created_at": "2026-08-13T02:49:23.163762+00:00",
