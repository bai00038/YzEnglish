  "id": 1865,
  "scene_id": 43,
  "line_order": 9,
  "step": null,
  "speaker": "Pharmacist",
  "speaker_zh": "药剂师",
  "dialogue_en": "It might make you drowsy, so avoid driving.",
  "dialogue_zh": "它可能会让你犯困，所以请避免开车。",
  "start_time": 18.08,
  "end_time": 21.24,
