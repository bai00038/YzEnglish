# Function Compute / local runtime
NODE_ENV=development
PORT=9000
ALLOWED_ORIGINS=https://staging.learnyzenglish.com,http://localhost:5173
COOKIE_DOMAIN=.learnyzenglish.com

# Generate separate random values; never commit real values.
SESSION_SECRET=replace-with-at-least-32-random-bytes
CODE_PEPPER=replace-with-a-different-random-secret

# Aliyun RAM credentials. Use a dedicated RAM role in Function Compute.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=

# OSS
OSS_REGION=oss-ap-southeast-1
OSS_BUCKET=yz-english-videos
OSS_SIGNED_URL_TTL_SECONDS=600

# Membership records live in a separate private bucket, never in the public content bucket.
MEMBERSHIP_OSS_BUCKET=yz-english-membership
MEMBERSHIP_DATA_PREFIX=_private/membership

# Local testing only. Production must use oss.
MEMBERSHIP_REPOSITORY=memory
