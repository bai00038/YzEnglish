# Server environment only. All payment work is test/staging-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_YEAR_ID=
STRIPE_PRICE_TWO_YEAR_ID=
STRIPE_LEGACY_PRICE_YEAR_ID=
STRIPE_LEGACY_PRICE_TWO_YEAR_ID=
PAYMENTS_SITE_ORIGIN=https://staging.learnyzenglish.com
PAYMENTS_PURCHASE_PATH=/membership
PAYMENTS_DATA_PREFIX=_private/payments-staging
# Aliyun DirectMail transport for the membership-code email. All three are
# required; when any is missing, mail stays in the outbox unsent
# (emailStatus "pending_configuration").
DIRECTMAIL_ACCOUNT_NAME=
DIRECTMAIL_ACCESS_KEY_ID=
DIRECTMAIL_ACCESS_KEY_SECRET=
DIRECTMAIL_FROM_ALIAS=Yz English
DIRECTMAIL_REGION_ID=ap-southeast-1
DIRECTMAIL_ENDPOINT=https://dm.ap-southeast-1.aliyuncs.com/
