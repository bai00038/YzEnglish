# Copy this file to .env.local and fill in your own Supabase project values
# (Settings > API in the Supabase Dashboard). Never commit the real values —
# .env* is already gitignored.
#
# Not read by the app yet: src/data/scenes-access.ts and src/data/resources.ts
# still serve the static mock data. These variables are here so the client
# can be wired up in a later step without another round of setup.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
