# Copy this file to .env.local and fill in your own Supabase project values
# (Settings > API in the Supabase Dashboard). Never commit the real values —
# .env* is already gitignored.
#
# VITE_SUPABASE_PUBLISHABLE_KEY is the public "publishable" key (safe for a
# browser bundle, respects Row Level Security). Never put the secret /
# service_role key here — it must never reach client code.
#
# If these are missing, the app falls back to static mock data in local dev
# only (see src/lib/supabaseClient.ts) and logs a console warning. Production
# builds require both variables to be set.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
